# Local development. Copy to .env (never commit .env).
DATABASE_URL=postgres://localhost:5432/sfms_dev?sslmode=disable
TEST_DATABASE_URL=postgres://localhost:5432/sfms_test?sslmode=disable
DBMATE_MIGRATIONS_DIR=db/migrations
DBMATE_SCHEMA_FILE=db/schema.sql

# API (apps/api)
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PORTAL_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000
# Development only — returns OTP codes in API responses until an SMS gateway is configured.
OTP_DEV_ECHO=true
JOBS_ENABLED=true

# Maps: Stadia API key — server-side only (the API proxies tiles; never sent to browsers).
STADIA_API_KEY=
