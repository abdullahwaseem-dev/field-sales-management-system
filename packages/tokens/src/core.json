{
  "$description": "Theme-independent tokens: spacing (4/8 scale), radius, sizes, typography, motion.",
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" }, "0_5": { "$value": "2px" }, "1": { "$value": "4px" }, "1_5": { "$value": "6px" },
    "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" }, "5": { "$value": "20px" },
    "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" }, "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" }, "xs": { "$value": "4px" }, "sm": { "$value": "6px" }, "md": { "$value": "10px" },
    "lg": { "$value": "14px" }, "xl": { "$value": "20px" }, "2xl": { "$value": "28px" }, "full": { "$value": "9999px" }
  },
  "size": {
    "$type": "dimension",
    "touch-min": { "$value": "48px", "$description": "Minimum touch target (48dp Android / 44pt iOS floor)" },
    "control-sm": { "$value": "32px" }, "control-md": { "$value": "40px" }, "control-lg": { "$value": "48px" },
    "control-mobile": { "$value": "52px" },
    "hero-action": { "$value": "176px", "$description": "Diameter of the mobile Check In / Check Out control" },
    "sidebar": { "$value": "264px" }, "sidebar-collapsed": { "$value": "72px" },
    "icon-xs": { "$value": "14px" }, "icon-sm": { "$value": "16px" }, "icon-md": { "$value": "20px" },
    "icon-lg": { "$value": "24px" }, "icon-xl": { "$value": "32px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "latin": { "$value": ["Inter Variable", "Inter"], "$description": "Web loads the self-hosted variable font (\"Inter Variable\"); Flutter bundles static \"Inter\"." },
      "arabic": { "$value": ["IBM Plex Sans Arabic"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }
    }
  },
  "type": {
    "$description": "Type scale. lineHeight is for Latin; lineHeightArabic is taller because Arabic needs more vertical room. tracking applies to Latin only — Arabic letter-spacing is always 0.",
    "display":  { "$value": { "size": 36, "lineHeight": 44, "lineHeightArabic": 56, "weight": 600, "tracking": -0.02 } },
    "headline": { "$value": { "size": 28, "lineHeight": 36, "lineHeightArabic": 46, "weight": 600, "tracking": -0.015 } },
    "title-lg": { "$value": { "size": 22, "lineHeight": 28, "lineHeightArabic": 36, "weight": 600, "tracking": -0.01 } },
    "title":    { "$value": { "size": 18, "lineHeight": 26, "lineHeightArabic": 32, "weight": 600, "tracking": 0 } },
    "subtitle": { "$value": { "size": 16, "lineHeight": 24, "lineHeightArabic": 28, "weight": 600, "tracking": 0 } },
    "body-lg":  { "$value": { "size": 16, "lineHeight": 24, "lineHeightArabic": 28, "weight": 400, "tracking": 0 } },
    "body":     { "$value": { "size": 14, "lineHeight": 20, "lineHeightArabic": 24, "weight": 400, "tracking": 0 } },
    "label":    { "$value": { "size": 14, "lineHeight": 20, "lineHeightArabic": 24, "weight": 500, "tracking": 0 } },
    "label-sm": { "$value": { "size": 12, "lineHeight": 16, "lineHeightArabic": 20, "weight": 500, "tracking": 0.01 } },
    "caption":  { "$value": { "size": 12, "lineHeight": 16, "lineHeightArabic": 20, "weight": 400, "tracking": 0 } },
    "kpi":      { "$value": { "size": 30, "lineHeight": 36, "lineHeightArabic": 44, "weight": 600, "tracking": -0.02 } },
    "timer":    { "$value": { "size": 40, "lineHeight": 48, "lineHeightArabic": 52, "weight": 600, "tracking": -0.02 } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" }, "fast": { "$value": "120ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] },
      "emphasized": { "$value": [0.05, 0.7, 0.1, 1] }
    }
  },
  "status": {
    "$description": "Attendance statuses. Each ships with an icon (Lucide name, same set on web and Flutter) and an i18n label key, so status is never conveyed by colour alone.",
    "present":        { "$value": { "icon": "circle-check",    "label": "status.present" } },
    "late":           { "$value": { "icon": "clock-alert",     "label": "status.late" } },
    "absent":         { "$value": { "icon": "circle-x",        "label": "status.absent" } },
    "suspected_fake": { "$value": { "icon": "shield-question", "label": "status.suspected_fake" } },
    "confirmed_fake": { "$value": { "icon": "shield-x",        "label": "status.confirmed_fake" } },
    "on_leave":       { "$value": { "icon": "calendar-days",   "label": "status.on_leave" } }
  }
}
